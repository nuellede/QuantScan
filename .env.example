# GEMINI_API_KEY: Wajib diisi untuk fitur AI (Chart Pattern Scanner, Bedah Berita AI, & Asisten AI Eksekusi).
# - Di AI Studio: dikonfigurasi otomatis dari panel Settings > Secrets.
# - Di Vercel: tambahkan GEMINI_API_KEY di Project Settings > Environment Variables (Production, Preview, Development).
# PENTING: Jangan pernah menambahkan prefix VITE_ pada GEMINI_API_KEY agar kunci tetap aman di sisi server.
GEMINI_API_KEY=

# APP_URL: URL aplikasi saat di-hosting (opsional untuk deployment lokal/Cloud Run; Vercel menyuntikkan VERCEL_URL otomatis).
APP_URL=
